# First-run profile for a 12 GB RTX 3060 that also drives the desktop (WDDM, not headless).
#
# NOT BENCHMARKED. Nothing in this repo has been run end-to-end on this card yet -- the model
# isn't downloaded and the expert store isn't packed. These are deliberately conservative
# starting points derived from:
#   - the actual hardware probe: GPU total 12,288 MiB, ~2,825 MiB already used by dwm.exe +
#     Discord before this process even starts (checked via nvidia-smi on 2026-10-26);
#   - the engine's own sizing code (qwen38-flash-offload/qwen38/expert_cache.py: Pool.__init__
#     queries real free VRAM via torch.cuda.mem_get_info() and allocates slots from whatever is
#     left after QWEN38_EC_RESERVE_GB, so undersizing these is safe -- it just caps slot count --
#     while oversizing them risks OOM during model load, before the graceful
#     `except torch.OutOfMemoryError: break` fallback even gets a chance to run for cache chunks);
#   - the upstream SKILL.md note: "Keep QWEN38_EC_MAX_SLOTS=1376 when a desktop runs on the same
#     GPU" (that number was tuned for a 24 GB card; scaled down here for 12 GB).
#
# Usage:
#   set -a; source profiles/rtx3060-12gb.env; set +a
#   scripts/run_capped.sh 9 -- python3 qwen_server.py --model ./model --store ./store/qwen.bin \
#       --ram-gb 9 --cache "$QWEN_CACHE_TOKENS" --chunk 8192 --port 30000
#
# Tune ONE value at a time against the server's own stdout (it prints QWEN_VRAM_BUDGET on start,
# and the Pool prints its slot count), per qwen38-flash-offload/skills/qwen38-offload-setup
# "Step 2: choose the mode" / "Step 6: run".

# --- Expert-cache VRAM budget (qwen38-flash-offload/qwen38/expert_cache.py) ---
# Start with elastic/staging OFF entirely so the very first load attempt spends VRAM only on the
# dense model + a small KV cache + a minimal fixed expert-slot pool. Raise these only after that
# baseline loads and serves a request without OOM.
export QWEN38_EC_ELASTIC_GB=0
export QWEN38_EC_STAGE_GB=0
export QWEN38_EC_RESERVE_GB=1.0
export QWEN38_EC_MAX_SLOTS=256

# --- Whole-card watchdog (memory_guard.DeviceMemory now reads this; see patch) ---
# NVML reports device-wide usage under WDDM (the desktop compositor + anything else on the GPU
# counts against this number too), so this is a whole-card cap, not a "just our process" cap.
# 11.5 GB leaves ~0.8 GB under the card's physical 12,288 MiB (12.88 GB decimal) for the desktop.
export QWEN_VRAM_LIMIT_BYTES=11500000000

# --- Context length ---
# The README's 262144-token showcase ran on a 4090 capped to 16 GB. Do not start there on a card
# with ~9 GB of real headroom after desktop overhead -- KV cache size scales with this number and
# competes directly with the (already minimal) expert-cache budget above.
export QWEN_CACHE_TOKENS=16384

# --- Host RAM cache (passed as --ram-gb on the CLI, not an env var; documented here for context) ---
# Checked: `free -g` and .wslconfig both need re-confirming against whatever is free *after*
# everything else running on this box, not the .wslconfig memory=40GB ceiling alone.
# Suggested first value: --ram-gb 9 (matches the systemd-run MemoryMax in scripts/run_capped.sh).
